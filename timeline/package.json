{
  "name": "dsh-mek-bot-timeline",
  "version": "0.2.17",
  "description": "Task trees and progress reports for MEK Bot chats and groups.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": { "dsh": ">=0.2.3-alpha.2 <0.3.0" },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["host.js", "client.js", "icon.svg", "locale/", "LICENSE", "docs/THIRD_PARTY_NOTICES.md"],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
